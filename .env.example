# Copie este arquivo para .env e preencha.
# Nao commite o .env (esta no .gitignore).

# Chaves publicas do browser (NEXT_PUBLIC_ sao embutidas no bundle).
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave de servidor: usada pelos scripts de banco, nunca pelo browser.
SUPABASE_SECRET_KEY=eyJ...

# Token da plataforma Supabase (https://supabase.com/dashboard/account/tokens).
# Necessario para scripts/supabase.ps1 e scripts/aplicar-migrations.ps1.
SUPABASE_ACCESS_TOKEN=sbp_...
