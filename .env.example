# Copie este arquivo para .env e preencha.
# Nao commite o .env (esta no .gitignore).

# Chaves do browser: so o que comeca com VITE_ entra no bundle.
# SUPABASE_SECRET_KEY e SUPABASE_ACCESS_TOKEN ficam fora do cliente.
VITE_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave de servidor: usada pelos scripts de banco, nunca pelo browser.
SUPABASE_SECRET_KEY=eyJ...

# Token da plataforma Supabase (https://supabase.com/dashboard/account/tokens).
# Necessario para scripts/supabase.ps1 e scripts/aplicar-migrations.ps1.
SUPABASE_ACCESS_TOKEN=sbp_...

# Senhas das contas de teste criadas por scripts/seed.ps1.
# Geradas por voce e guardadas so aqui: nunca no codigo.
SEED_SENHA_ADMIN=
SEED_SENHA_CENTRAL=
SEED_SENHA_VIANORTE=
